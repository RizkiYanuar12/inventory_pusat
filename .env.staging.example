# DB LATIHAN untuk debug localhost. Copy menjadi `.env.staging` (tak ter-commit, lihat .gitignore),
# isi dari project Supabase BARU (staging): Settings -> API -> URL + service_role key.
# Pakai: $env:USE_STAGING=1; node server.js   (PowerShell)
# Prod (default): node server.js   (baca .env seperti biasa)
PORT=3000
VITE_SUPABASE_URL=https://xxx-staging.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=isi-dari-dashboard-staging
VITE_SUPABASE_SERVICE_ROLE=isi-dari-dashboard-staging
